import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../providers/master_pin_provider.dart';

class SetPinScreen extends ConsumerStatefulWidget {
  const SetPinScreen({super.key});

  @override
  ConsumerState<SetPinScreen> createState() => _SetPinScreenState();
}

class _SetPinScreenState extends ConsumerState<SetPinScreen> {
  final _pinController = TextEditingController();
  final _confirmController = TextEditingController();
  final _questionController = TextEditingController();
  final _answerController = TextEditingController();
  bool _isLoading = false;
  String _errorMessage = '';

  Future<void> _handleSave() async {
    if (_pinController.text.length != 4) {
      setState(() => _errorMessage = 'PINは4桁で入力してください。');
      return;
    }
    if (_pinController.text != _confirmController.text) {
      setState(() => _errorMessage = '確認用PINが一致しません。');
      return;
    }
    if (_questionController.text.isEmpty || _answerController.text.isEmpty) {
      setState(() => _errorMessage = '秘密の質問と答えを入力してください。');
      return;
    }

    setState(() {
      _isLoading = true;
      _errorMessage = '';
    });

    try {
      await ref.read(masterPinProvider.notifier).setPinWithRecovery(
        pin: _pinController.text,
        question: _questionController.text,
        answer: _answerController.text,
      );

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('設定を保存しました。')),
        );

        // 💡 秘密の質問（再設定）から遷移してきた場合は画面を閉じる
        // 初期設定の場合は下に画面がないので何も起きませんが、
        // AuthWrapper が自動的に AuthScreen に差し替えてくれます。
        if (Navigator.of(context).canPop()) {
          Navigator.of(context).pop();
        }
      }
    } catch (e) {
      if (mounted) setState(() => _errorMessage = 'エラー: $e');
    } finally {
      if (mounted) setState(() => _isLoading = false);
    }
  }

  @override
  void dispose() {
    _pinController.dispose();
    _confirmController.dispose();
    _questionController.dispose();
    _answerController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('PIN設定'),
        // 再設定時のみ戻るボタンを表示
        automaticallyImplyLeading: Navigator.of(context).canPop(),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(24.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            const Text('新しいPINと秘密の質問を設定してください。', textAlign: TextAlign.center),
            const SizedBox(height: 20),
            TextField(
              controller: _pinController,
              keyboardType: TextInputType.number,
              maxLength: 4,
              obscureText: true,
              decoration: const InputDecoration(labelText: '新しいPIN (4桁)', border: OutlineInputBorder()),
            ),
            TextField(
              controller: _confirmController,
              keyboardType: TextInputType.number,
              maxLength: 4,
              obscureText: true,
              decoration: const InputDecoration(labelText: '確認用PIN', border: OutlineInputBorder()),
            ),
            const SizedBox(height: 20),
            const Divider(),
            const Text('秘密の質問（忘れた際の復旧用）', style: TextStyle(fontWeight: FontWeight.bold)),
            const SizedBox(height: 10),
            TextField(
              controller: _questionController,
              decoration: const InputDecoration(labelText: '質問 (例: 好きな食べ物は？)', border: OutlineInputBorder()),
            ),
            const SizedBox(height: 10),
            TextField(
              controller: _answerController,
              decoration: const InputDecoration(labelText: '答え', border: OutlineInputBorder()),
            ),
            const SizedBox(height: 30),
            if (_errorMessage.isNotEmpty)
              Text(_errorMessage, style: const TextStyle(color: Colors.red), textAlign: TextAlign.center),
            const SizedBox(height: 10),
            ElevatedButton(
              onPressed: _isLoading ? null : _handleSave,
              style: ElevatedButton.styleFrom(padding: const EdgeInsets.symmetric(vertical: 16)),
              child: _isLoading ? const CircularProgressIndicator() : const Text('設定を保存して開始'),
            ),
          ],
        ),
      ),
    );
  }
}
