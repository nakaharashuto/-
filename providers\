// ファイルパス: lib/providers/master_pin_provider.dart
// 役割: マスターPINの状態と安全なストレージへの保存/読み込みを管理する

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter_secure_storage/flutter_secure_storage.dart'; 

class MasterPinState {
	final String? masterPin;
	final bool isPinSet;

	MasterPinState({this.masterPin}) : isPinSet = masterPin != null;
}

class MasterPinNotifier extends AsyncNotifier<MasterPinState> {
	static const _pinKey = 'master_pin_secure';
	
	final _secureStorage = const FlutterSecureStorage();

	@override
	Future<MasterPinState> build() async {
		debugPrint('MasterPinNotifier: PINデータの初期ロードを開始 (Secure Storage)');
		
		final pin = await _secureStorage.read(key: _pinKey);

		debugPrint('MasterPinNotifier: PINロード完了. PIN設定済み: ${pin != null}');
		
		return MasterPinState(masterPin: pin);
	}
	
	Future<void> setPin(String pin) async {
		if (state.isLoading) return; 
		
		await _secureStorage.write(key: _pinKey, value: pin);
		
		state = AsyncData(MasterPinState(masterPin: pin));
		debugPrint('MasterPinNotifier: PINが安全に設定されました。');
	}

	Future<void> clearPin() async {
		if (state.isLoading) return;
		
		await _secureStorage.delete(key: _pinKey);
		
		state = AsyncData(MasterPinState(masterPin: null));
		debugPrint('MasterPinNotifier: PINが削除されました。');
	}

	bool checkCurrentPin(String pin) {
		final currentPinState = state.value;
		if (currentPinState == null || !currentPinState.isPinSet) {
			return false;
		}
		return currentPinState.masterPin == pin;
	}
}

final masterPinProvider = AsyncNotifierProvider<MasterPinNotifier, MasterPinState>(() {
	return MasterPinNotifier();
});

