// ファイルパス: lib/models/password_entry.dart 
// 役割: パスワードエントリのデータ構造を定義　

import 'package:isar/isar.dart'; 

part 'password_entry.g.dart';

@Collection()
class PasswordEntry {
  // 1. ID (プライマリキー)
  // 1. 💡 【修正】Id get isarId を Id isarId に変更（ゲッターではなくフィールドとして認識させる）
  //    Isarはゲッターをプライマリキーとして使う場合、フィールドとして宣言されていることを要求します。
  //    ただし、この方法では毎回ハッシュ計算が走るため、フィールドとして定義し、コンストラクタで計算します。
  final Id isarId; 

  // 2. 💡 【修正】String id から isarId を計算するための static fastHash メソッドを追加
  static int fastHash(String string) {
    var hash = 0xcbf29ce484222325;
    
    var i = 0;
    while (i < string.length) {
      final codeUnit = string.codeUnitAt(i++);
      hash ^= codeUnit >> 8;
      hash *= 0x100000001b3;
      hash ^= codeUnit & 0xFF;
      hash *= 0x100000001b3;
    }
    
    return hash;
  }

  @Index(unique: true, replace: true)
  final String id;

  @Index() // サービス名で検索することが多いと想定
  final String serviceName; 
  
  @Index() // ユーザー名で検索することが多いと想定
  final String username;
  
  final String encryptedPassword;
  // 💡 追加: 復号に必要なIV（初期化ベクトル）をBase64形式で保存する
  final String ivBase64;
  final DateTime createdAt;
  // 💡 1. 'url' フィールドを追加
  final String url;
  
  // 更新時に変更される可能性があるため final を外すことも検討できます
  DateTime? updatedAt;
  
  PasswordEntry({
    required this.id,
    required this.serviceName,
    required this.username,
    required this.encryptedPassword,
    required this.ivBase64, // 💡 追加
    required this.createdAt,
    this.url = '', 
    this.updatedAt,
  }):isarId = fastHash(id);

  PasswordEntry copyWith({
    String? serviceName,
    String? username,
    String? encryptedPassword,
    String? ivBase64, // 💡 追加
    DateTime? updatedAt,
    String? url,
    DateTime? createdAt,
  }) {
    return PasswordEntry(
      id: id,
      serviceName: serviceName ?? this.serviceName,
      username: username ?? this.username,
      encryptedPassword: encryptedPassword ?? this.encryptedPassword,
      ivBase64: ivBase64 ?? this.ivBase64, // 💡 追加
      createdAt: createdAt ?? this.createdAt,
      updatedAt: updatedAt ?? this.updatedAt,
      url: url ?? this.url,
    );
  }

  @override
  String toString() {
    return 'PasswordEntry(service: $serviceName, user: $username, encrypted: $encryptedPassword)';
  }
}
