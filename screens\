// ファイルパス: lib/screens/add_password_screen.dart
// 役割: 新しいパスワード情報の追加 および 既存パスワード情報の編集 を行う汎用フォーム画面

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:uuid/uuid.dart';
import '../providers/password_provider.dart';
import '../services/generator.dart';

const uuid = Uuid();

class PasswordFormScreen extends ConsumerStatefulWidget {
	final PasswordEntry? entry;
	
	final String? initialGeneratedPassword;
	
	const PasswordFormScreen({
		super.key,
		this.entry,
		this.initialGeneratedPassword,
	});

	@override
	ConsumerState<PasswordFormScreen> createState() => _PasswordFormScreenState();
}

class _PasswordFormScreenState extends ConsumerState<PasswordFormScreen> {
	final serviceController = TextEditingController();
	final usernameController = TextEditingController();
	final passwordController = TextEditingController();
	final urlController = TextEditingController();

	final formKey = GlobalKey<FormState>();
	late final bool isEditing;

	@override
	void initState() {
		super.initState();
		isEditing = widget.entry != null;
		
		if (isEditing) {
			serviceController.text = widget.entry!.title;
			usernameController.text = widget.entry!.username;
			passwordController.text = widget.entry!.password;
			urlController.text = widget.entry!.url;
		} 
		else if (widget.initialGeneratedPassword != null) {
			passwordController.text = widget.initialGeneratedPassword!;
		}
	}

	@override
	void dispose() {
		serviceController.dispose();
		usernameController.dispose();
		passwordController.dispose();
		urlController.dispose();
		super.dispose();
	}

	void _submitForm() {
		if (formKey.currentState!.validate()) {
			final newEntry = PasswordEntry(
				id: isEditing ? widget.entry!.id : uuid.v4(),
				title: serviceController.text,
				username: usernameController.text,
				password: passwordController.text,
				url: urlController.text,
				createdAt: isEditing ? widget.entry!.createdAt : DateTime.now(),
			);

			final notifier = ref.read(passwordListProvider.notifier);
			
			if (isEditing) {
				notifier.updatePassword(newEntry);
			} else {
				notifier.addPassword(newEntry);
			}
			
			ScaffoldMessenger.of(context).showSnackBar(
				SnackBar(content: Text(isEditing ? '${newEntry.title} を更新しました。' : '${newEntry.title} をリストに追加しました。')),
			);
			
			Navigator.of(context).pop();
		}
	}

	void _generatePassword() {
		final generatedPassword = PasswordGeneratorService.generatePassword(
			length: 16,
			useUpper: true,
			useNumbers: true,
			useSymbols: true,
		);
		passwordController.text = generatedPassword;
		ScaffoldMessenger.of(context).showSnackBar(
			const SnackBar(content: Text('強力なパスワードを自動生成しました。')),
		);
	}

	@override
	Widget build(BuildContext context) {
		final theme = Theme.of(context);
		final titleText = isEditing ? 'パスワードを編集' : '新しいパスワードを追加';

		return Scaffold(
			appBar: AppBar(
				title: Text(titleText),
				backgroundColor: theme.colorScheme.primary,
				foregroundColor: Colors.white,
				automaticallyImplyLeading: true, // デフォルトに戻す
			),
			body: SingleChildScrollView(
				padding: const EdgeInsets.all(20.0),
				child: Form(
					key: formKey,
					child: Column(
						crossAxisAlignment: CrossAxisAlignment.start,
						children: [
							_buildTextField(
								controller: serviceController,
								label: 'サービス名 / ウェブサイト (必須)',
								icon: Icons.title,
								validator: (value) => value!.isEmpty ? 'タイトルは必須です' : null,
							),
							const SizedBox(height: 20),

							_buildTextField(
								controller: usernameController,
								label: 'ユーザー名 / メールアドレス',
								icon: Icons.person,
							),
							const SizedBox(height: 20),

							_buildPasswordField(
								controller: passwordController,
								validator: (value) => value!.isEmpty ? 'パスワードは必須です' : null,
								onGenerate: _generatePassword,
							),
							const SizedBox(height: 20),

							_buildTextField(
								controller: urlController,
								label: 'URL',
								icon: Icons.link,
								keyboardType: TextInputType.url,
							),
							const SizedBox(height: 30),

							SizedBox(
								width: double.infinity,
								child: ElevatedButton.icon(
									onPressed: _submitForm,
									icon: Icon(isEditing ? Icons.update : Icons.save),
									label: Text(isEditing ? '更新' : '保存', style: const TextStyle(fontSize: 18)),
									style: ElevatedButton.styleFrom(
										padding: const EdgeInsets.symmetric(vertical: 15),
										backgroundColor: theme.colorScheme.secondary,
										foregroundColor: Colors.white,
										shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
									),
								),
							),
						],
					),
				),
			),
		);
	}

	Widget _buildTextField({
		required TextEditingController controller,
		required String label,
		required IconData icon,
		int maxLines = 1,
		TextInputType keyboardType = TextInputType.text,
		String? Function(String?)? validator,
	}) {
		return TextFormField(
			controller: controller,
			maxLines: maxLines,
			keyboardType: keyboardType,
			validator: validator,
			decoration: InputDecoration(
				labelText: label,
				prefixIcon: Icon(icon),
				border: OutlineInputBorder(
					borderRadius: BorderRadius.circular(10),
				),
				filled: true,
				fillColor: Colors.white,
			),
		);
	}

	Widget _buildPasswordField({
		required TextEditingController controller,
		String? Function(String?)? validator,
		required VoidCallback onGenerate,
	}) {
		return TextFormField(
			controller: controller,
			obscureText: true,
			validator: validator,
			decoration: InputDecoration(
				labelText: 'パスワード (必須)',
				prefixIcon: const Icon(Icons.vpn_key),
				suffixIcon: IconButton(
					icon: const Icon(Icons.refresh),
					onPressed: onGenerate,
					tooltip: 'パスワードを自動生成',
				),
				border: OutlineInputBorder(
					borderRadius: BorderRadius.circular(10),
				),
				filled: true,
				fillColor: Colors.white,
			),
		);
	}
}

