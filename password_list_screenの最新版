// ファイルパス: lib/screens/password_list_screen.dart
// 役割: パスワードエントリの一覧表示、詳細表示、編集/削除操作（外部ProviderとFormに依存）

import '../models/password_entry.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../providers/password_provider.dart';
import 'add_password_screen.dart';

// -------------------------------------------------------------------------
// 1. PasswordDetailScreen (詳細画面)
// 💡 表示/非表示の状態を管理するため StatefulWidget に変更しました
// -------------------------------------------------------------------------
class PasswordDetailScreen extends StatefulWidget {
  final PasswordEntry entry;

  const PasswordDetailScreen({super.key, required this.entry});

  @override
  State<PasswordDetailScreen> createState() => _PasswordDetailScreenState();
}

class _PasswordDetailScreenState extends State<PasswordDetailScreen> {
  // 💡 パスワードが表示されているかどうかの状態
  bool _isPasswordVisible = false;

  void _copyToClipboard(BuildContext context, String text, String label) {
    Clipboard.setData(ClipboardData(text: text));
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('$labelをクリップボードにコピーしました')),
    );
  }

  // 💡 第5引数に isPasswordField を追加し、パスワード行だけ特別な処理をするようにしました
  Widget _buildDetailItem(BuildContext context, IconData icon, String title, String value, bool isPasswordField) {
    final theme = Theme.of(context);
    
    // 💡 パスワード行かつ非表示モードなら伏字にする
    String displayValue = (isPasswordField && !_isPasswordVisible) ? '••••••••' : value;

    return Card(
      margin: const EdgeInsets.symmetric(vertical: 8.0, horizontal: 0),
      elevation: 2,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      child: ListTile(
        leading: Icon(icon, color: theme.colorScheme.primary),
        title: Text(title, style: theme.textTheme.labelLarge),
        subtitle: Text(displayValue, style: theme.textTheme.titleMedium?.copyWith(fontWeight: FontWeight.bold)),
        trailing: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            // 💡 パスワード行のときだけ「目のアイコン」を表示
            if (isPasswordField)
              IconButton(
                icon: Icon(
                  _isPasswordVisible ? Icons.visibility : Icons.visibility_off,
                  color: Colors.black,
                ),
                onPressed: () {
                  setState(() {
                    _isPasswordVisible = !_isPasswordVisible;
                  });
                },
              ),
            IconButton(
              icon: Icon(Icons.copy, color: theme.colorScheme.secondary),
              onPressed: () => _copyToClipboard(context, value, title),
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    
    return Scaffold(
      appBar: AppBar(
        title: Text(widget.entry.serviceName),
        backgroundColor: theme.colorScheme.primary,
        foregroundColor: Colors.white,
        actions: [
          IconButton(
            icon: const Icon(Icons.edit),
            onPressed: () {
              Navigator.of(context).push(
                MaterialPageRoute(
                  builder: (ctx) => PasswordFormScreen(entry: widget.entry),
                ),
              );
            },
          ),
        ],
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            _buildDetailItem(context, Icons.title, 'サービス名', widget.entry.serviceName, false),
            _buildDetailItem(context, Icons.person, 'ユーザー名', widget.entry.username, false),
            // 💡 第5引数を true に設定
            _buildDetailItem(context, Icons.lock, 'パスワード', widget.entry.encryptedPassword, true),
            _buildDetailItem(context, Icons.link, 'URL', widget.entry.url, false),
            Card(
              margin: const EdgeInsets.symmetric(vertical: 8.0, horizontal: 0),
              elevation: 2,
              shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
              child: ListTile(
                leading: Icon(Icons.calendar_today, color: Colors.grey.shade600),
                title: Text('作成日', style: theme.textTheme.labelLarge),
                subtitle: Text(
                  '${widget.entry.createdAt.year}/${widget.entry.createdAt.month}/${widget.entry.createdAt.day}',
                  style: theme.textTheme.titleSmall,
                ),
              ),
            ),
            const SizedBox(height: 30),
            Center(
              child: Text(
                '※クリップボードへのコピーは自動ロックの対象となります',
                style: theme.textTheme.bodySmall?.copyWith(color: Colors.grey),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

// -------------------------------------------------------------------------
// 2. PasswordListScreen (一覧画面)
// -------------------------------------------------------------------------
class PasswordListScreen extends ConsumerWidget {
  const PasswordListScreen({super.key});

  void _copyToClipboard(BuildContext context, String password) {
    Clipboard.setData(ClipboardData(text: password));
    ScaffoldMessenger.of(context).showSnackBar(
      const SnackBar(content: Text('パスワードをコピーしました (5秒後に自動ロック)')),
    );
  }
  
  void _showDeleteConfirmationDialog(BuildContext context, WidgetRef ref, PasswordEntry entry) {
    showDialog(
      context: context,
      builder: (ctx) => AlertDialog(
        title: const Text('本当に削除しますか？'),
        content: Text('${entry.serviceName} のパスワードを削除します。'),
        actions: <Widget>[
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(),
            child: const Text('キャンセル'),
          ),
          ElevatedButton(
            onPressed: () {
              ref.read(passwordListProvider.notifier).deletePassword(entry.id); 
              Navigator.of(ctx).pop();
              ScaffoldMessenger.of(context).showSnackBar(
                SnackBar(content: Text('${entry.serviceName} を削除しました'))
              );
            },
            style: ElevatedButton.styleFrom(backgroundColor: Colors.red, foregroundColor: Colors.white),
            child: const Text('削除'),
          ),
        ],
      ),
    );
  }

  void _editEntry(BuildContext context, PasswordEntry entry) {
    Navigator.of(context).push(
      MaterialPageRoute(builder: (ctx) => PasswordFormScreen(entry: entry)),
    );
  }

  void _showDetailScreen(BuildContext context, PasswordEntry entry) {
    Navigator.of(context).push(
      MaterialPageRoute(builder: (ctx) => PasswordDetailScreen(entry: entry)),
    );
  }

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final listAsyncValue = ref.watch(passwordListProvider); 
    final theme = Theme.of(context);

    return Scaffold(
      body: listAsyncValue.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (err, stack) => Center(child: Text('エラー: $err')),
        data: (entries) {
          if (entries.isEmpty) {
            return const Center(child: Text('まだ登録されていません'));
          }
          
          return ListView.separated(
            itemCount: entries.length,
            separatorBuilder: (context, index) => const Divider(height: 1),
            itemBuilder: (context, index) {
              final entry = entries[index];
              return Dismissible(
                key: ValueKey(entry.id),
                direction: DismissDirection.endToStart,
                background: Container(
                  color: Colors.red,
                  alignment: Alignment.centerRight,
                  padding: const EdgeInsets.symmetric(horizontal: 20),
                  child: const Icon(Icons.delete, color: Colors.white),
                ),
                onDismissed: (_) {
                  ref.read(passwordListProvider.notifier).deletePassword(entry.id);
                },
                child: ListTile(
                  leading: Icon(Icons.vpn_key, color: theme.colorScheme.primary),
                  title: Text(entry.serviceName, style: const TextStyle(fontWeight: FontWeight.bold)),
                  subtitle: Text(entry.username),
                  trailing: Row(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      IconButton(
                        icon: const Icon(Icons.copy, size: 20),
                        onPressed: () => _copyToClipboard(context, entry.encryptedPassword),
                      ),
                      IconButton(
                        icon: const Icon(Icons.edit, size: 20),
                        onPressed: () => _editEntry(context, entry),
                      ),
                      IconButton(
                        icon: const Icon(Icons.delete, size: 20, color: Colors.red),
                        onPressed: () => _showDeleteConfirmationDialog(context, ref, entry),
                      ),
                    ],
                  ),
                  onTap: () => _showDetailScreen(context, entry), 
                ),
              );
            },
          );
        },
      ),
    );
  }
}
