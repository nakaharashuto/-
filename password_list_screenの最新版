import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../providers/password_provider.dart';
import '../providers/auth_provider.dart';
import 'add_password_screen.dart';
import 'password_detail_screen.dart'; // ★追加

class PasswordListScreen extends ConsumerWidget {
  const PasswordListScreen({super.key});

  Future<bool> _authenticate(BuildContext context, WidgetRef ref) async {
    final authService = ref.read(authServiceProvider);
    try {
      if (await authService.isBiometricsAvailable()) {
        if (await authService.authenticate()) return true;
      }
    } catch (e) {
      debugPrint('Auth Error: $e');
    }

    if (!context.mounted) return false;
    return await showDialog<bool>(
          context: context,
          barrierDismissible: false,
          builder: (context) => const PinReAuthDialog(), // PasswordDetailScreenと同じファイルにあるのでOK
        ) ??
        false;
  }

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final listAsyncValue = ref.watch(passwordListProvider);

    return Scaffold(
      appBar: AppBar(title: const Text('パスワード一覧')),
      body: listAsyncValue.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (err, stack) => Center(child: Text('エラー: $err')),
        data: (entries) {
          if (entries.isEmpty) return const Center(child: Text('登録がありません'));
          return ListView.separated(
            itemCount: entries.length,
            separatorBuilder: (context, index) => const Divider(height: 1),
            itemBuilder: (context, index) {
              final entry = entries[index];
              return ListTile(
                leading: CircleAvatar(
                  backgroundColor: Theme.of(context).colorScheme.primaryContainer,
                  child: Icon(
                    Icons.vpn_key,
                    size: 20,
                    color: Theme.of(context).colorScheme.primary,
                  ),
                ),
                title: Text(entry.serviceName, style: const TextStyle(fontWeight: FontWeight.bold)),
                subtitle: Text(entry.username),
                trailing: const Icon(Icons.chevron_right),
                onTap: () async {
                  final authenticated = await _authenticate(context, ref);
                  if (authenticated && context.mounted) {
                    Navigator.of(context).push(
                      MaterialPageRoute(builder: (ctx) => PasswordDetailScreen(entry: entry)),
                    );
                  }
                },
              );
            },
          );
        },
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => Navigator.of(context).push(
          MaterialPageRoute(builder: (ctx) => const PasswordFormScreen()),
        ),
        child: const Icon(Icons.add),
      ),
    );
  }
}
