// ファイルパス: lib/screens/add_password_screen.dart
// 役割: 新しいパスワード情報の追加 および 既存パスワード情報の編集 を行う汎用フォーム画面

import '../models/password_entry.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:uuid/uuid.dart';
import '../providers/password_provider.dart';
import '../services/generator.dart';

const uuid = Uuid();

// ⚠️ 修正点 A: initialGeneratedPassword 引数を残す（初期値設定用）
class PasswordFormScreen extends ConsumerStatefulWidget {
	// 編集対象のエントリをオプションで受け取る
	final PasswordEntry? entry;
	
	// 💡 初期パスワードを受け取るための引数
	final String? initialGeneratedPassword;
	
	const PasswordFormScreen({
		super.key,
		this.entry,
		this.initialGeneratedPassword, // コンストラクタに残す
	});

	@override
	ConsumerState<PasswordFormScreen> createState() => _PasswordFormScreenState();
}

class _PasswordFormScreenState extends ConsumerState<PasswordFormScreen> {
  bool _isObscured = true;
	// ControllerをStateで保持
	final serviceController = TextEditingController();
	final usernameController = TextEditingController();
	final passwordController = TextEditingController();
	final urlController = TextEditingController();

	final formKey = GlobalKey<FormState>();
	// 編集モード判定
	late final bool isEditing;

	@override
	void initState() {
		super.initState();
		isEditing = widget.entry != null;
		
		// 編集モードの場合、既存のデータをControllerに設定
		if (isEditing) {
			serviceController.text = widget.entry!.serviceName;
			usernameController.text = widget.entry!.username;
			passwordController.text = widget.entry!.encryptedPassword;
			urlController.text = widget.entry!.url;
		} 
		// 💡 修正点 B: 自動生成パスワードが渡された場合、新規作成モードでのみフィールドに設定する (自動保存ロジックは削除)
		else if (widget.initialGeneratedPassword != null) {
			passwordController.text = widget.initialGeneratedPassword!;
		}
		// 標準の新規作成の場合、コントローラーは空のまま
	}

	@override
	void dispose() {
		serviceController.dispose();
		usernameController.dispose();
		passwordController.dispose();
		urlController.dispose();
		super.dispose();
	}

	void _submitForm() {
		if (formKey.currentState!.validate()) {
			// 新規/更新のどちらの場合でも、新しいデータを構築
			// final newEntry = PasswordEntry(
//   // ... フィールド ...
//   encryptedPassword: passwordController.text,
//   // ...
// );
// ----------------------------------------------------
// この newEntry の作成は不要になりました。

final idToUse = isEditing ? widget.entry!.id : uuid.v4();
final plainPassword = passwordController.text;

final notifier = ref.read(passwordListProvider.notifier);
      
if (isEditing) {
  // 💡 【修正点】更新ロジックを実装
            // 既存のエントリのコピーを作成し、更新されたフィールドを設定
            final updatedEntry = widget.entry!.copyWith(
                serviceName: serviceController.text,
                username: usernameController.text,
                url: urlController.text,
                // encryptedPassword はフォームから取得せず、プロバイダに平文を渡す
            );
            
            // 🚨 updatePassword メソッドを呼び出し、平文パスワードを渡す
            notifier.updatePassword(
                updatedEntry,
                newPlainPassword: plainPassword, // これが暗号化されます
            );
  
} else {
  // 新規エントリの追加
  
  // 💡 修正後の呼び出し: 名前付き引数をすべて渡す
  notifier.addPassword(
    id: idToUse, // 必須
    serviceName: serviceController.text, // 必須
    username: usernameController.text, // 必須
    plainPassword: plainPassword, // 必須
    url: urlController.text, // 必須
  );
}
			
			// 💡 修正点: 自動保存を廃止したため、常にスナックバーを表示する
			ScaffoldMessenger.of(context).showSnackBar(
				SnackBar(content: Text(isEditing ? '${serviceController.text} を更新しました。' : '${serviceController.text} をリストに追加しました。')),
			);
			
			// 画面を閉じる
			Navigator.of(context).pop();
		}
	}

	// ⚠️ 修正: パスワード自動生成ボタンの処理
	void _generatePassword() {
		final generatedPassword = PasswordGeneratorService.generatePassword(
			length: 16,
			useUpper: true,
			useNumbers: true,
			useSymbols: true,
		);
		// 生成されたパスワードをフィールドに設定
		passwordController.text = generatedPassword;
		ScaffoldMessenger.of(context).showSnackBar(
			const SnackBar(content: Text('強力なパスワードを自動生成しました。')),
		);
	}

	@override
	Widget build(BuildContext context) {
		// 💡 修正点 C: 自動保存時のタイトル変更ロジックを削除
		final theme = Theme.of(context);
		final titleText = isEditing ? 'パスワードを編集' : '新しいパスワードを追加';

		return Scaffold(
			appBar: AppBar(
				title: Text(titleText),
				backgroundColor: theme.colorScheme.primary,
				foregroundColor: Colors.white,
				// 💡 修正点: 自動保存時の UI 調整を削除
				automaticallyImplyLeading: true, // デフォルトに戻す
			),
			body: SingleChildScrollView(
				padding: const EdgeInsets.all(20.0),
				// 💡 修正点: 自動保存時の IgnorePointer を削除
				child: Form(
					key: formKey,
					child: Column(
						crossAxisAlignment: CrossAxisAlignment.start,
						children: [
							_buildTextField(
								controller: serviceController,
								label: 'サービス名 / ウェブサイト (必須)',
								icon: Icons.title,
								validator: (value) => value!.isEmpty ? 'タイトルは必須です' : null,
							),
							const SizedBox(height: 20),

							_buildTextField(
								controller: usernameController,
								label: 'ユーザー名 / メールアドレス',
								icon: Icons.person,
							),
							const SizedBox(height: 20),

							// ⚠️ 修正: パスワードフィールドにジェネレーター機能を追加
							_buildPasswordField(
								controller: passwordController,
								validator: (value) => value!.isEmpty ? 'パスワードは必須です' : null,
								onGenerate: _generatePassword, // 生成ボタンのコールバックを渡す
							),
							const SizedBox(height: 20),

							_buildTextField(
								controller: urlController,
								label: 'URL',
								icon: Icons.link,
								keyboardType: TextInputType.url,
							),
							const SizedBox(height: 30),

							SizedBox(
								width: double.infinity,
								child: ElevatedButton.icon(
									onPressed: _submitForm, // 保存処理を呼び出す
									icon: Icon(isEditing ? Icons.update : Icons.save),
									label: Text(isEditing ? '更新' : '保存', style: const TextStyle(fontSize: 18)),
									style: ElevatedButton.styleFrom(
										padding: const EdgeInsets.symmetric(vertical: 15),
										backgroundColor: theme.colorScheme.secondary,
										foregroundColor: Colors.white,
										shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
									),
								),
							),
						],
					),
				),
			),
		);
	}

	// ⚠️ 修正: Widgetメソッドはクラス外から移動し、StatefulWidgetのプライベートメソッドへ変更
	Widget _buildTextField({
		required TextEditingController controller,
		required String label,
		required IconData icon,
		int maxLines = 1,
		TextInputType keyboardType = TextInputType.text,
		String? Function(String?)? validator,
	}) {
		return TextFormField(
			controller: controller,
			maxLines: maxLines,
			keyboardType: keyboardType,
			validator: validator,
			decoration: InputDecoration(
				labelText: label,
				prefixIcon: Icon(icon),
				border: OutlineInputBorder(
					borderRadius: BorderRadius.circular(10),
				),
				filled: true,
				fillColor: Colors.white,
			),
		);
	}

	// ⚠️ 修正: パスワードフィールドにジェネレーターボタンを追加するためのロジック
  Widget _buildPasswordField({
    required TextEditingController controller,
    String? Function(String?)? validator,
    required VoidCallback onGenerate,
  }) {
    return TextFormField(
      controller: controller,
      obscureText: _isObscured, // 👈 変数を使う
      validator: validator,
      decoration: InputDecoration(
        labelText: 'パスワード (必須)',
        prefixIcon: const Icon(Icons.vpn_key),
        // Rowを使ってボタンを2つ並べる
        suffixIcon: Row(
          mainAxisSize: MainAxisSize.min, // 右側に寄せる
          children: [
            IconButton(
              icon: Icon(_isObscured ? Icons.visibility : Icons.visibility_off),
              onPressed: () {
                setState(() {
                  _isObscured = !_isObscured;
                });
              },
            ),
            IconButton(
              icon: const Icon(Icons.refresh),
              onPressed: onGenerate,
              tooltip: 'パスワードを自動生成',
            ),
          ],
        ),
        border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
        filled: true,
        fillColor: Colors.white,
      ),
    );
  }
}
