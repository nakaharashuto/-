import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:local_auth/local_auth.dart';
import '../providers/auth_provider.dart';
import '../providers/master_pin_provider.dart';

class AuthScreen extends ConsumerStatefulWidget {
	const AuthScreen({super.key});

	@override
	ConsumerState<AuthScreen> createState() => _AuthScreenState();
}

class _AuthScreenState extends ConsumerState<AuthScreen> {
	final _pinController = TextEditingController();
	String _errorMessage = '';
	bool _isLoading = false;
	bool _biometricsAvailable = false;
    bool _isBiometricsChecking = true;

	@override
	void initState() {
		super.initState();
		_checkBiometrics();
	}

	@override
	void dispose() {
		_pinController.dispose();
		super.dispose();
	}

	Future<void> _checkBiometrics() async {
        if (!mounted) return;
        setState(() => _isBiometricsChecking = true);
        
		final LocalAuthentication auth = LocalAuthentication();
		try {
			final bool available = await auth.canCheckBiometrics;
            
            final List<BiometricType> availableTypes = await auth.getAvailableBiometrics();
            
			if (mounted) {
				setState(() {
					_biometricsAvailable = available && availableTypes.isNotEmpty;
                    _isBiometricsChecking = false;
                    
                    if (!available) {
                         debugPrint('Biometrics Check: デバイスが生体認証をサポートしていません。');
                    } else if (availableTypes.isEmpty) {
                         debugPrint('Biometrics Check: デバイスはサポートしていますが、認証情報が登録されていません。');
                    }
				});
			}
		} catch (e) {
			debugPrint('生体認証チェックエラー: $e');
			if (mounted) {
				setState(() {
					_biometricsAvailable = false;
                    _isBiometricsChecking = false;
				});
			}
		}
	}

	void _submitPin() {
		if (_isLoading) return;

		final pin = _pinController.text;
		if (pin.length != 4) {
			setState(() => _errorMessage = 'PINは4桁の数字で入力してください。');
			return;
		}

		setState(() {
			_isLoading = true;
			_errorMessage = '';
		});
        
		final masterPinState = ref.read(masterPinProvider).value; 
		final authNotifier = ref.read(authProvider.notifier);
		
		if (masterPinState == null || !masterPinState.isPinSet) {
			setState(() => _errorMessage = 'マスターPINが設定されていません。');
			if (mounted) setState(() => _isLoading = false);
			return;
		}
        
        final masterPin = masterPinState.masterPin;

		if (authNotifier.tryPin(pin, masterPin!)) {
		} else {
			setState(() => _errorMessage = 'PINが正しくありません。');
		}

		if (mounted) {
			setState(() => _isLoading = false);
		}
	}

	Future<void> _startBiometricsAuth() async {
		if (_isLoading || !_biometricsAvailable) return;

		setState(() {
			_isLoading = true;
			_errorMessage = '';
		});

		final authNotifier = ref.read(authProvider.notifier);
		final success = await authNotifier.authenticateWithBiometrics();

		if (!success) {
			setState(() => _errorMessage = '認証に失敗しました。PINで試してください。');
		} else {
        }

		if (mounted) {
			setState(() => _isLoading = false);
		}
	}

	@override
	Widget build(BuildContext context) {
		final theme = Theme.of(context);

		return Scaffold(
			body: Center(
				child: SingleChildScrollView(
					padding: const EdgeInsets.all(32.0),
					child: Column(
						mainAxisAlignment: MainAxisAlignment.center,
						crossAxisAlignment: CrossAxisAlignment.stretch,
						children: <Widget>[
							Icon(Icons.lock_person, size: 80, color: theme.colorScheme.primary),
							const SizedBox(height: 16),
							Text(
								'ロック解除',
								style: theme.textTheme.headlineMedium?.copyWith(
									fontWeight: FontWeight.bold,
									color: theme.colorScheme.primary,
								),
								textAlign: TextAlign.center,
							),
							const SizedBox(height: 32),

							TextField(
								controller: _pinController,
								obscureText: true,
								keyboardType: TextInputType.number,
								maxLength: 4,
								textAlign: TextAlign.center,
								style: const TextStyle(fontSize: 24, letterSpacing: 8),
								decoration: const InputDecoration(
									labelText: '4桁のPINコード',
									counterText: '',
									border: OutlineInputBorder(borderRadius: BorderRadius.all(Radius.circular(12))),
									prefixIcon: Icon(Icons.vpn_key),
								),
							),
							const SizedBox(height: 16),

							if (_errorMessage.isNotEmpty)
								Padding(
									padding: const EdgeInsets.only(bottom: 16),
									child: Text(
										_errorMessage,
										style: const TextStyle(color: Colors.red, fontWeight: FontWeight.bold),
										textAlign: TextAlign.center,
									),
								),

							ElevatedButton(
								onPressed: _isLoading ? null : _submitPin,
								style: ElevatedButton.styleFrom(
									minimumSize: const Size(double.infinity, 50),
									backgroundColor: theme.colorScheme.primary,
									foregroundColor: theme.colorScheme.onPrimary,
									shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
									elevation: 4,
								),
								child: _isLoading && _errorMessage.isEmpty
									? const SizedBox(
										width: 24,
										height: 24,
										child: CircularProgressIndicator(color: Colors.white, strokeWidth: 3),
									  )
									: const Text('PINでロック解除', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
							),
							
							if (_isBiometricsChecking) ...[
                                const SizedBox(height: 24),
								const Divider(thickness: 1, indent: 32, endIndent: 32),
								const SizedBox(height: 24),
                                const Center(child: CircularProgressIndicator()),
                                const SizedBox(height: 8),
                                const Center(child: Text('生体認証の確認中...')),
                            ]
							else if (_biometricsAvailable) ...[
								const SizedBox(height: 24),
								const Divider(thickness: 1, indent: 32, endIndent: 32),
								const SizedBox(height: 24),
								
								OutlinedButton.icon(
									onPressed: _isLoading ? null : _startBiometricsAuth,
									icon: const Icon(Icons.fingerprint, size: 28),
									label: const Text('生体認証でロック解除', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
									style: OutlinedButton.styleFrom(
										minimumSize: const Size(double.infinity, 50),
										foregroundColor: theme.colorScheme.secondary,
										side: BorderSide(color: theme.colorScheme.secondary, width: 2),
										shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
									),
								),
							],
						],
					),
				),
			),
		);
	}
}

