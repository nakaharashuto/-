class Credential {
  final String id;
  final String serviceName;
  final String username;
  final String password;
  final DateTime createdAt;
  
  Credential({
    required this.id,
    required this.serviceName,
    required this.username,
    required this.password,
    required this.createdAt,
  });

  Map<String, dynamic> toMap() {
    return {
      'id': id,
      'serviceName': serviceName,
      'username': username,
      'password': password,
      'createdAt': createdAt.toIso8601String(),
    };
  }

  factory Credential.fromMap(Map<String, dynamic> map) {
    return Credential(
      id: map['id'] as String,
      serviceName: map['serviceName'] as String,
      username: map['username'] as String,
      password: map['password'] as String,
      createdAt: DateTime.parse(map['createdAt'] as String),
    );
  }
}

final _dummyCredentials = [
  Credential(
    id: const Uuid().v4(),
    serviceName: 'Google',
    username: 'testuser@gmail.com',
    password: 'secure-password-123',
    createdAt: DateTime.now().subtract(const Duration(days: 5)),
  ),
  Credential(
    id: const Uuid().v4(),
    serviceName: 'Twitter',
    username: 'test_handle',
    password: 'another-strong-password',
    createdAt: DateTime.now().subtract(const Duration(days: 2)),
  ),
];

class PasswordNotifier extends StateNotifier<List<Credential>> {
  PasswordNotifier() : super(_dummyCredentials);

  void addCredential(Credential credential) {
    if (state.any((c) => c.id == credential.id)) {
      state = state.where((c) => c.id != credential.id).toList();
    }
    state = [...state, credential];
  }

  void updateCredential(Credential updatedCredential) {
    state = [
      for (final credential in state)
        if (credential.id == updatedCredential.id) updatedCredential else credential,
    ];
  }

  void deleteCredential(String id) {
    state = state.where((credential) => credential.id != id).toList();
  }
}

final passwordProvider = StateNotifierProvider<PasswordNotifier, List<Credential>>((ref) {
  return PasswordNotifier();
});

