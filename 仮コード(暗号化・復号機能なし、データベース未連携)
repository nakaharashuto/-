// ファイルパス: lib/providers/auth_provider.dart
// 役割: アプリの認証状態を管理する

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:local_auth/local_auth.dart';
import 'package:flutter/foundation.dart';

class AuthNotifier extends StateNotifier<bool> {
	AuthNotifier() : super(false);

	void login() {
		state = true;
	}

	void lockApp() {
		state = false;
	}

	bool tryPin(String pin, String masterPin) {
		if (pin == masterPin) {
			login();
			return true;
		}
		return false;
	}

	Future<bool> authenticateWithBiometrics() async {
		final LocalAuthentication auth = LocalAuthentication();
		bool didAuthenticate = false;

		try {
			final bool canCheckBiometrics = await auth.canCheckBiometrics;
			if (!canCheckBiometrics) {
				debugPrint('生体認証: デバイスが生体認証をサポートしていないか、設定されていません。');
				return false;
			}
            
            final List<BiometricType> availableBiometrics = await auth.getAvailableBiometrics();
            if (availableBiometrics.isEmpty) {
                debugPrint('生体認証: 生体認証が有効な認証手段として設定されていません。');
                return false;
            }

			didAuthenticate = await auth.authenticate(
				localizedReason: 'アプリをロック解除するには生体認証（指紋/顔）を行ってください',
				options: const AuthenticationOptions(
					useErrorDialogs: true,
					stickyAuth: true,
					biometricOnly: true, 
				),
			);

			if (didAuthenticate) {
				login();
				debugPrint('生体認証: 成功');
			} else {
				debugPrint('生体認証: ユーザーによってキャンセルされたか、認証に失敗しました。');
			}

		} catch (e) {
			debugPrint('生体認証エラー: $e'); 
			return false;
		}

		return didAuthenticate;
	}
}

final authProvider = StateNotifierProvider<AuthNotifier, bool>((ref) {
	return AuthNotifier();
});

