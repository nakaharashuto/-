import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'dart:io'; 
import 'dart:async'; 
import 'package:flutter_secure_storage/flutter_secure_storage.dart'; 
import '../providers/auth_provider.dart';
import '../providers/master_pin_provider.dart';

class AuthScreen extends ConsumerStatefulWidget {
  const AuthScreen({super.key});

  @override
  ConsumerState<AuthScreen> createState() => _AuthScreenState();
}

class _AuthScreenState extends ConsumerState<AuthScreen> {
  final _pinController = TextEditingController();
  final _storage = const FlutterSecureStorage();
  
  String _errorMessage = '';
  bool _isLoading = false;
  bool _biometricsAvailable = false;
  bool _isBiometricsChecking = true;

  // --- 入力制限用の状態管理 ---
  int _remainingLockSeconds = 0;
  Timer? _lockTimer;
  static const int _maxAttempts = 3;
  static const String _keyAttempts = 'pin_attempts_count';
  static const String _keyLockUntil = 'pin_lock_until_time';

  // プラットフォーム判定のヘルパー
  bool get _isDesktopPlatform {
    try {
      return Platform.isWindows || Platform.isLinux || Platform.isMacOS;
    } catch (e) {
      return false;
    }
  }

  @override
  void initState() {
    super.initState();
    // アプリ起動時に前回のロック状態を復元
    _checkLockStatus();
    if (!_isDesktopPlatform) {
      _checkBiometrics();
    } else {
      _isBiometricsChecking = false;
      _biometricsAvailable = false;
    }
  }

  @override
  void dispose() {
    _pinController.dispose();
    _lockTimer?.cancel();
    super.dispose();
  }

  // --- セキュリティ・ロックロジック ---

  Future<void> _checkLockStatus() async {
    final lockUntilStr = await _storage.read(key: _keyLockUntil);
    if (lockUntilStr == null) return;

    final lockUntil = DateTime.parse(lockUntilStr);
    final now = DateTime.now();

    if (lockUntil.isAfter(now)) {
      _startLockTimer(lockUntil.difference(now).inSeconds);
    } else {
      await _storage.delete(key: _keyLockUntil);
      await _storage.delete(key: _keyAttempts);
    }
  }

  void _startLockTimer(int seconds) {
    setState(() {
      _remainingLockSeconds = seconds;
      _errorMessage = '試行回数を超えました。一時的にロックされています。';
    });

    _lockTimer?.cancel();
    _lockTimer = Timer.periodic(const Duration(seconds: 1), (timer) {
      if (!mounted) {
        timer.cancel();
        return;
      }
      if (_remainingLockSeconds <= 1) {
        timer.cancel();
        setState(() {
          _remainingLockSeconds = 0;
          _errorMessage = '';
        });
        _storage.delete(key: _keyLockUntil);
        _storage.delete(key: _keyAttempts);
      } else {
        setState(() {
          _remainingLockSeconds--;
        });
      }
    });
  }

  Future<void> _handleFailure() async {
    final attemptsStr = await _storage.read(key: _keyAttempts) ?? '0';
    final attempts = int.parse(attemptsStr) + 1;
    await _storage.write(key: _keyAttempts, value: attempts.toString());

    if (attempts >= _maxAttempts) {
      // 3回失敗で1分間のロックを適用
      const lockDuration =  Duration(seconds: 60);
      final lockUntil = DateTime.now().add(lockDuration);
      await _storage.write(key: _keyLockUntil, value: lockUntil.toIso8601String());
      _startLockTimer(lockDuration.inSeconds);
    } else {
      setState(() {
        _errorMessage = 'PINが正しくありません。あと${_maxAttempts - attempts}回でロックされます。';
      });
    }
  }

  Future<void> _handleSuccess() async {
    await _storage.delete(key: _keyAttempts);
    await _storage.delete(key: _keyLockUntil);
  }

  // --- 認証フロー ---

  Future<void> _checkBiometrics() async {
    if (!mounted) return;
    setState(() => _isBiometricsChecking = true);
    final authService = ref.read(authServiceProvider); 
    try {
      final available = await authService.isBiometricsAvailable(); 
      if (mounted) {
        setState(() {
          _biometricsAvailable = available;
          _isBiometricsChecking = false;
        });
      }
    } catch (e) {
      if (mounted) setState(() => _isBiometricsChecking = false);
    }
  }

  Future<void> _submitPin() async {
    if (_isLoading || _remainingLockSeconds > 0) return;

    final pin = _pinController.text;
    if (pin.length != 4) {
      setState(() => _errorMessage = 'PINは4桁の数字で入力してください。');
      return;
    }

    setState(() {
      _isLoading = true;
      _errorMessage = '';
    });
    
    final masterPinState = ref.read(masterPinProvider).value; 
    final authNotifier = ref.read(authProvider.notifier);
    
    if (masterPinState == null || !masterPinState.isPinSet) {
      setState(() {
        _errorMessage = 'マスターPINが設定されていません。';
        _isLoading = false;
      });
      return;
    }
    
    final masterPin = masterPinState.masterPin!; 

    if (authNotifier.tryPin(pin, masterPin)) {
      await _handleSuccess();
      // 成功時はProviderの状態更新により自動的に画面が切り替わります
    } else {
      await _handleFailure();
      _pinController.clear();
    }

    if (mounted) setState(() => _isLoading = false);
  }

  Future<void> _startBiometricsAuth() async {
    if (_isLoading || !_biometricsAvailable || _remainingLockSeconds > 0) return;
    if (_isDesktopPlatform) return;

    setState(() {
      _isLoading = true;
      _errorMessage = '';
    });

    final authNotifier = ref.read(authProvider.notifier);
    final success = await authNotifier.authenticateWithBiometrics();

    if (!success) {
      setState(() => _errorMessage = '認証に失敗しました。PINで試してください。');
    } else {
      await _handleSuccess();
    }

    if (mounted) setState(() => _isLoading = false);
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final shouldShowBiometrics = !_isDesktopPlatform && _biometricsAvailable && !_isBiometricsChecking;
    final isLocked = _remainingLockSeconds > 0;

    return Scaffold(
      body: Center(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(32.0),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: <Widget>[
              // アイコンの切り替え
              Icon(
                isLocked ? Icons.timer_off : Icons.lock_person, 
                size: 80, 
                color: isLocked ? Colors.orange : theme.colorScheme.primary
              ),
              const SizedBox(height: 16),
              Text(
                isLocked ? 'セキュリティロック' : 'ロック解除',
                style: theme.textTheme.headlineMedium?.copyWith(
                  fontWeight: FontWeight.bold,
                  color: isLocked ? Colors.orange : theme.colorScheme.primary,
                ),
                textAlign: TextAlign.center,
              ),
              const SizedBox(height: 32),

              TextField(
                controller: _pinController,
                obscureText: true,
                enabled: !isLocked && !_isLoading, 
                keyboardType: TextInputType.number,
                maxLength: 4,
                textAlign: TextAlign.center,
                style: const TextStyle(fontSize: 24, letterSpacing: 8),
                decoration: InputDecoration(
                  labelText: isLocked ? '制限がかかっています' : '4桁のPINコード',
                  counterText: '',
                  border: const OutlineInputBorder(borderRadius: BorderRadius.all(Radius.circular(12))),
                  prefixIcon: const Icon(Icons.vpn_key),
                ),
                onSubmitted: (_) => _submitPin(),
              ),
              const SizedBox(height: 16),

              // エラーまたはカウントダウンの表示
              if (_errorMessage.isNotEmpty || isLocked)
                Padding(
                  padding: const EdgeInsets.only(bottom: 16),
                  child: Text(
                    isLocked ? 'あと $_remainingLockSeconds 秒待機してください' : _errorMessage,
                    style: TextStyle(
                      color: isLocked ? Colors.orange : Colors.red, 
                      fontWeight: FontWeight.bold
                    ),
                    textAlign: TextAlign.center,
                  ),
                ),

              ElevatedButton(
                onPressed: (isLocked || _isLoading) ? null : _submitPin,
                style: ElevatedButton.styleFrom(
                  minimumSize: const Size(double.infinity, 50),
                  backgroundColor: theme.colorScheme.primary,
                  foregroundColor: theme.colorScheme.onPrimary,
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                  elevation: 4,
                ),
                child: _isLoading && _errorMessage.isEmpty
                    ? const SizedBox(
                        width: 24,
                        height: 24,
                        child: CircularProgressIndicator(color: Colors.white, strokeWidth: 3),
                      )
                    : const Text('PINでロック解除', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
              ),
              
              if (shouldShowBiometrics) ...[
                const SizedBox(height: 24),
                const Divider(thickness: 1, indent: 32, endIndent: 32),
                const SizedBox(height: 24),
                
                OutlinedButton.icon(
                  onPressed: (isLocked || _isLoading) ? null : _startBiometricsAuth,
                  icon: const Icon(Icons.fingerprint, size: 28),
                  label: const Text('生体認証でロック解除', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
                  style: OutlinedButton.styleFrom(
                    minimumSize: const Size(double.infinity, 50),
                    foregroundColor: theme.colorScheme.secondary,
                    side: BorderSide(color: theme.colorScheme.secondary, width: 2),
                    shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(8)),
                  ),
                ),
              ],
            ],
          ),
        ),
      ),
    );
  }
}
