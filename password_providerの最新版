// ファイルパス: lib/providers/password_provider.dart
// 役割: パスワードエントリのデータモデルと、エントリリストを管理するRiverpod Provider (メモリ内管理のみ)

import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:uuid/uuid.dart';
import 'package:flutter/foundation.dart';
// import 'package:shared_preferences/shared_preferences.dart'; // 💡 削除
// import '../services/generator.dart'; // 💡 削除
import 'package:flutter_application_3/models/password_entry.dart'; // Isarモデル
import '../services/isar_service.dart'; // Isarサービス

const uuid = Uuid();

class PasswordListNotifier extends AsyncNotifier<List<PasswordEntry>> {
    // 1. IsarService への参照を持つ
    late IsarService _isarService;

    @override
    Future<List<PasswordEntry>> build() async {
        // 2. サービスプロバイダからインスタンスを取得
        _isarService = ref.watch(isarServiceProvider);

        debugPrint('PasswordListNotifier: Isarから初期データを読み込みます。');
        
        // 3. Isarから全てのパスワードデータを取得して初期状態とする
        return await _isarService.getAllPasswords();
    }
    
    // --- CRUD 操作 (IsarServiceを呼び出すように修正) ---

    Future<void> addPassword({
  required String id,
  required String serviceName,
  required String username,
  required String plainPassword, // 💡 平文のパスワード
  required String url,
}) async {
  // 1. まずメモリ内の状態を更新するために、平文パスワードで一時的なエントリを作成
  // 💡 ivBase64 は IsarService 内で生成・上書きされるため、ここでは空文字を渡します
  final newEntry = PasswordEntry(
    id: id,
    serviceName: serviceName,
    username: username,
    // 💡 ここではメモリ表示用として平文をセット (または空文字列)
    encryptedPassword: '', // 💡 サービス側で上書きされるので空でOK
      ivBase64: '',          // 💡 追加：一旦空で作成 
    createdAt: DateTime.now(),
    url: url,
  );
  
  // 2. IsarServiceに保存を依頼 (暗号化はサービス側で行われる)
  // 💡 savePassword に平文のパスワードを渡す
  await _isarService.savePassword(newEntry, plainPassword); 

  // 💡 【修正点】保存後、データベースから最新のデータを全て再取得
    final latestEntries = await _isarService.getAllPasswords();

  // 3. Riverpodの状態を最新のデータセットで完全に置き換える
    // 💡 この latestEntries には、有効な code を持った newEntry が含まれている
    state = AsyncData(latestEntries);
}

    Future<void> updatePassword(PasswordEntry updatedEntry, {String? newPlainPassword}) async {
      //追加した
      debugPrint('--- [UPDATE START] ---');
      // 💡 【追加】更新対象のUUIDをログに出力
            if (updatedEntry.id.isEmpty) {
         debugPrint('🚨 ERROR: Attempted to update an entry with a missing ID!');
       // IDがない場合は処理を中断
         return; 
      } 
      debugPrint('Updating entry UUID: ${updatedEntry.id}'); // 💡 更新対象のIDをログ出力
      try {
        // 1. 永続化のための準備
        final passwordToSave = newPlainPassword ?? updatedEntry.encryptedPassword;
        final now = DateTime.now();
        
        final entryToSave = updatedEntry.copyWith(
            updatedAt: now,
            encryptedPassword: passwordToSave, 
        );
        
        // 2. サービス層へ保存を依頼
        await _isarService.savePassword(entryToSave, passwordToSave);
        debugPrint('--- [SAVE SUCCESSFUL] ---'); // 💡 成功ログを追加
        
        // 3. 💡 決定的な修正: データベースから最新のデータを全て再取得する
        final latestEntries = await _isarService.getAllPasswords();
        
        // 4. Riverpodの状態を最新のデータセットで完全に置き換える
        state = AsyncData(latestEntries);
        
        // 💡 3. リストの要素数が変化していないか確認するログ
        debugPrint('--- [STATE UPDATED] --- List Count: ${latestEntries.length}'); // 💡 これを必ず確認

    } catch (e, stack) {
        // 🚨 エラーが発生した場合、ここでログが出力されるはず
        debugPrint('--- [UPDATE FAILED] ---');
        debugPrint('Error: $e');
        debugPrint('Stack: $stack');
        state = AsyncError('パスワードの更新に失敗しました: $e', stack);
        // rethrow; // rethrow は UI のエラー処理に任せる
    }
}

    Future<void> deletePassword(String id) async {
        final currentList = state.value;
        if (currentList == null) return;
        
        // 1. Isarから削除
        await _isarService.deletePassword(id);
        
        // 2. メモリ内の状態を更新
        state = AsyncData(currentList.where((entry) => entry.id != id).toList());
    }
}

final passwordListProvider = 
    AsyncNotifierProvider<PasswordListNotifier, List<PasswordEntry>>(() {
    return PasswordListNotifier();
});
